# 公共函数脚本：属性计算
# 在此编写可复用函数；本文件不作为事件入口执行。
# 使用方在文件开头添加：引用 "common/属性计算.nns"
引用 "system/global/g_角色属性变量.nns"






函数 计算角色属性(d:单位, m:整数, 点伤:整数, 百分比:小数)
    # 保存本次变化前的点伤和倍率，不保存角色最终攻击。
    整数 旧点伤1 = 附加物理攻击1
    整数 旧点伤2 = 附加物理攻击2
    小数 旧倍率1 = 增加物理攻击百分比1
    小数 旧倍率2 = 增加物理攻击百分比2

    如果 m == 0
        增加物理攻击百分比1 += 百分比
        增加物理攻击百分比2 += 百分比
        附加物理攻击1 += 点伤
        附加物理攻击2 += 点伤
    否则
        增加物理攻击百分比1 -= 百分比
        增加物理攻击百分比2 -= 百分比
        附加物理攻击1 -= 点伤
        附加物理攻击2 -= 点伤
    结束

    # 百分比作用于角色当前攻击；先解除旧倍率，再更新点伤并应用新倍率。
    整数 新攻击1 = (d.战斗属性.最小物理攻击 / 旧倍率1 + 附加物理攻击1 - 旧点伤1) * 增加物理攻击百分比1
    整数 新攻击2 = (d.战斗属性.最大物理攻击 / 旧倍率2 + 附加物理攻击2 - 旧点伤2) * 增加物理攻击百分比2
    整数 刷新差值1 = 新攻击1 - d.战斗属性.最小物理攻击
    整数 刷新差值2 = 新攻击2 - d.战斗属性.最大物理攻击
    d.战斗属性.最小物理攻击 += 刷新差值1
    d.战斗属性.最大物理攻击 += 刷新差值2
    d.发送消息("物理属性刷新:模式={m},点伤={点伤},百分比={百分比},变化={刷新差值1}/{刷新差值2},攻击={d.战斗属性.最小物理攻击}/{d.战斗属性.最大物理攻击}")
结束
