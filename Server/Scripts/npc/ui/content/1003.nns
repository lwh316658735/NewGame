# 说明: 处理内容模板“测试面板”中链接“链接2”点击后的操作。
# @参数 无。
# @返回 空 - 不返回业务结果。
# @UI脚本入口 内容|1003|link
函数 链接_添加徒弟_点击()
    #日志("玩家不在线或者不存在")
    文本 mc = ""
    布尔 结果 = 显示输入框(10, mc)
    如果 结果
        结果 = 服务器.查询角色(mc)
        如果 结果
            如果 !角色.师徒.查询徒弟(mc)
                布尔 jg = 角色.师徒.添加徒弟(mc)
                如果 jg
                    日志("添加{mc}徒弟成功")
                否则
                    日志("{mc}已经拒绝")
                结束
            否则
                日志("{mc}已经是你的徒弟了")
            结束
        否则
            日志("{mc}不在线或者不存在")
        结束
    否则
        日志("请输入名字")
    结束
结束

# 说明: 处理内容模板“测试面板”中链接“删除徒弟”点击后的操作。
# @参数 无。
# @返回 空 - 不返回业务结果。
# @UI脚本入口 内容|1003|link2
函数 链接_删除徒弟_点击()
    文本 mc2 = ""
    布尔 结果 = 显示输入框(10, mc2)
    如果 结果
        如果 角色.师徒.查询徒弟(mc2)
            角色.师徒.删除徒弟(mc2)
            日志("删除{mc2}徒弟成功")
        否则
            日志("{mc2}不是你的徒弟")
        结束
    否则
        日志("请输入名字")
    结束
结束

